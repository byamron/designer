{
  "name": "designer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @designer/server",
    "build": "npm run build -w @designer/web",
    "start": "npm run build && npm run start -w @designer/server",
    "typecheck": "tsc -b packages/shared packages/server packages/web",
    "test": "npm test -w @designer/server && npm test -w @designer/web",
    "dev-instance": "node scripts/dev-instance.mjs",
    "app": "npm run build && electron packages/desktop"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
