# Dependency install scripts (preinstall/install/postinstall) run arbitrary code with your user's permissions, and this
# repository is installed on a machine that also holds your GitHub and Claude logins. No dependency here needs them
# (checked: `npm ci` + build + tests pass without), so they are off for everyone: you, CI, and Update & Restart.
# `npm run`, `npm test` and the project's own scripts are unaffected. See docs/security-audit-2026-11.md.
ignore-scripts=true
